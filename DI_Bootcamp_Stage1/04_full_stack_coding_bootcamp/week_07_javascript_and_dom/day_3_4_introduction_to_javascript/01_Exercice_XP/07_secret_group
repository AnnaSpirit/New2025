const names = ["Jack", "Philip", "Sarah", "Amanda", "Bernard", "Kyle"];


//1. A group of friends have decided to start a secret society. The society’s name will be the first letter of each of their names sorted in alphabetical order.  Hint: a string is an array of letters

const secretSociety = names.map(name => name[0]).sort().join('');
console.log(secretSociety); // Affiche "ABJKPS"


//2. Console.log the name of their secret society. The output should be “ABJKPS”

console.log(secretSociety); // Affiche "ABJKPS"